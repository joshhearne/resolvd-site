---
import { featureNav, featurePrefixes } from "../lib/featureNav";

const { pathname } = Astro.url;
type NavLink = { href: string; label: string; note?: string };
type NavGroup = { label: string; matchPrefixes: string[]; children: NavLink[] };
type NavEntry = NavLink | NavGroup;

const links: NavEntry[] = [
  { href: "/", label: "Overview" },
  {
    label: "Features",
    matchPrefixes: featurePrefixes,
    children: featureNav,
  },
  { href: "/install/", label: "Install" },
  { href: "/docs/",    label: "Docs" },
  { href: "/blog/",    label: "Blog" },
];

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

const isGroupActive = (g: NavGroup) =>
  g.matchPrefixes.some(p => pathname.startsWith(p));

const isGroup = (e: NavEntry): e is NavGroup => "children" in e;
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-header-bg)] backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="flex items-center gap-2.5 group">
      <img src="/icon.svg" alt="" width="32" height="32" class="rounded-lg shadow-[0_0_24px_rgba(34,197,94,0.25)] transition group-hover:shadow-[0_0_28px_rgba(34,197,94,0.45)]" />
      <span class="text-lg font-semibold tracking-tight">resolvd<span class="text-[var(--color-brand)]">.</span><span class="text-[var(--color-fg-muted)] font-normal">dev</span></span>
    </a>
    <ul class="hidden md:flex items-center gap-1 text-sm">
      {links.map(l => isGroup(l) ? (
        <li class="relative group">
          <button
            type="button"
            class={`inline-flex items-center gap-1 px-3 py-1.5 rounded-md transition ${isGroupActive(l)
              ? "text-[var(--color-fg-strong)] bg-[var(--color-surface-2)] border border-[var(--color-border)]"
              : "text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)]"}`}
            aria-haspopup="true"
            aria-expanded="false"
          >
            {l.label}
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-60 transition group-hover:opacity-100 group-focus-within:opacity-100"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition absolute left-0 top-full pt-2 w-72 z-50">
            <ul class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-lg p-1">
              {l.children.map(c => (
                <li>
                  <a
                    href={c.href}
                    class={`block px-3 py-2.5 rounded-md transition ${isActive(c.href)
                      ? "text-[var(--color-fg-strong)] bg-[var(--color-surface-2)]"
                      : "text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] hover:bg-[var(--color-surface-2)]"}`}
                  >
                    <div class="font-medium">{c.label}</div>
                    {c.note && <div class="text-xs text-[var(--color-fg-dim)] mt-0.5">{c.note}</div>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ) : (
        <li>
          <a
            href={l.href}
            class={`px-3 py-1.5 rounded-md transition ${isActive(l.href)
              ? "text-[var(--color-fg-strong)] bg-[var(--color-surface-2)] border border-[var(--color-border)]"
              : "text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)]"}`}
          >{l.label}</a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        title="Toggle theme"
        aria-label="Toggle theme"
        class="flex items-center justify-center w-9 h-9 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] hover:border-[var(--color-border-strong)] transition"
      >
        <span class="theme-icon-sun hidden" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </span>
        <span class="theme-icon-moon hidden" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </span>
        <span class="theme-icon-auto hidden" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v18"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
        </span>
      </button>
      <a href="https://github.com/joshhearne/resolvd" target="_blank" rel="noopener" class="hidden sm:inline-flex text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] px-3 py-1.5 rounded-md border border-[var(--color-border)] hover:border-[var(--color-border-strong)] transition">
        GitHub
      </a>
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-nav-panel"
        aria-expanded="false"
        class="md:hidden flex items-center justify-center w-9 h-9 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] hover:border-[var(--color-border-strong)] transition"
      >
        <svg class="mobile-nav-icon-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="mobile-nav-icon-close hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </nav>
  <div
    id="mobile-nav-panel"
    class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-header-bg)]"
  >
    <ul class="flex flex-col gap-1 px-6 py-4 text-sm">
      {links.map(l => isGroup(l) ? (
        <li class="mt-2">
          <div class="px-3 py-1.5 text-[10px] uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">{l.label}</div>
          <ul class="flex flex-col gap-1">
            {l.children.map(c => (
              <li>
                <a
                  href={c.href}
                  class={`block px-3 py-2.5 rounded-md transition ${isActive(c.href)
                    ? "text-[var(--color-fg-strong)] bg-[var(--color-surface-2)] border border-[var(--color-border)]"
                    : "text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] hover:bg-[var(--color-surface)]"}`}
                >{c.label}</a>
              </li>
            ))}
          </ul>
        </li>
      ) : (
        <li>
          <a
            href={l.href}
            class={`block px-3 py-2.5 rounded-md transition ${isActive(l.href)
              ? "text-[var(--color-fg-strong)] bg-[var(--color-surface-2)] border border-[var(--color-border)]"
              : "text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] hover:bg-[var(--color-surface)]"}`}
          >{l.label}</a>
        </li>
      ))}
      <li class="mt-2">
        <div class="px-3 py-1.5 text-[10px] uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Resources</div>
        <ul class="flex flex-col gap-1">
          <li>
            <a
              href="/manual/"
              class={`block px-3 py-2.5 rounded-md transition ${isActive("/manual/")
                ? "text-[var(--color-fg-strong)] bg-[var(--color-surface-2)] border border-[var(--color-border)]"
                : "text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] hover:bg-[var(--color-surface)]"}`}
            >Manual Setup</a>
          </li>
          <li>
            <a
              href="/changelog/"
              class={`block px-3 py-2.5 rounded-md transition ${isActive("/changelog/")
                ? "text-[var(--color-fg-strong)] bg-[var(--color-surface-2)] border border-[var(--color-border)]"
                : "text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] hover:bg-[var(--color-surface)]"}`}
            >Changelog</a>
          </li>
          <li class="sm:hidden">
            <a
              href="https://github.com/joshhearne/resolvd"
              target="_blank"
              rel="noopener"
              class="block px-3 py-2.5 rounded-md text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] hover:bg-[var(--color-surface)] transition"
            >GitHub ↗</a>
          </li>
        </ul>
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    var order = ["auto", "light", "dark"];
    var mql = window.matchMedia("(prefers-color-scheme: light)");

    function resolve(pref) {
      if (pref === "auto") return mql.matches ? "light" : "dark";
      return pref;
    }
    function apply(pref) {
      var resolved = resolve(pref);
      document.documentElement.setAttribute("data-theme", resolved);
      document.documentElement.setAttribute("data-theme-pref", pref);
      try { localStorage.setItem("theme", pref); } catch (e) {}
      paintIcon(pref);
    }
    function paintIcon(pref) {
      ["sun", "moon", "auto"].forEach(function (k) {
        var el = btn.querySelector(".theme-icon-" + k);
        if (el) el.classList.add("hidden");
      });
      var key = pref === "light" ? "sun" : pref === "dark" ? "moon" : "auto";
      var show = btn.querySelector(".theme-icon-" + key);
      if (show) show.classList.remove("hidden");
      btn.title = "Theme: " + pref + " (click to cycle)";
    }
    var current = document.documentElement.getAttribute("data-theme-pref") || "auto";
    paintIcon(current);

    btn.addEventListener("click", function () {
      var pref = document.documentElement.getAttribute("data-theme-pref") || "auto";
      var next = order[(order.indexOf(pref) + 1) % order.length];
      apply(next);
    });

    mql.addEventListener("change", function () {
      var pref = document.documentElement.getAttribute("data-theme-pref") || "auto";
      if (pref === "auto") apply("auto");
    });
  })();

  (function () {
    var btn = document.getElementById("mobile-nav-toggle");
    var panel = document.getElementById("mobile-nav-panel");
    if (!btn || !panel) return;
    var iconOpen = btn.querySelector(".mobile-nav-icon-open");
    var iconClose = btn.querySelector(".mobile-nav-icon-close");
    function setOpen(open) {
      if (open) {
        panel.classList.remove("hidden");
        btn.setAttribute("aria-expanded", "true");
        btn.setAttribute("aria-label", "Close menu");
        if (iconOpen) iconOpen.classList.add("hidden");
        if (iconClose) iconClose.classList.remove("hidden");
      } else {
        panel.classList.add("hidden");
        btn.setAttribute("aria-expanded", "false");
        btn.setAttribute("aria-label", "Open menu");
        if (iconOpen) iconOpen.classList.remove("hidden");
        if (iconClose) iconClose.classList.add("hidden");
      }
    }
    btn.addEventListener("click", function () {
      setOpen(btn.getAttribute("aria-expanded") !== "true");
    });
    panel.querySelectorAll("a").forEach(function (a) {
      a.addEventListener("click", function () { setOpen(false); });
    });
    window.matchMedia("(min-width: 768px)").addEventListener("change", function (e) {
      if (e.matches) setOpen(false);
    });
  })();
</script>
