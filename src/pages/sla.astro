---
import Layout from "../layouts/Layout.astro";
import FeatureFooter from "../components/FeatureFooter.astro";

const targets = [
  { p: "P1", response: "30 min", resolve: "4 hrs" },
  { p: "P2", response: "1 hr",   resolve: "8 hrs" },
  { p: "P3", response: "4 hrs",  resolve: "24 hrs" },
  { p: "P4", response: "8 hrs",  resolve: "72 hrs" },
  { p: "P5", response: "1 day",  resolve: "7 days" },
];

const lifecycle = [
  { evt: "Ticket created", action: "Both clocks start. Due-ats stamped from the resolved policy (project override > org default). Auto-assignment fires per priority." },
  { evt: "Status → awaiting_input / on_hold", action: "Both clocks pause. Vendor wait counted into `sla_vendor_wait_seconds`, internal hold into `sla_internal_hold_seconds`." },
  { evt: "Status leaves blocker state", action: "Clocks resume. Due-ats shift forward by paused duration." },
  { evt: "80% of clock elapsed", action: "Fires `fanoutSlaWarning` — pre-breach warning gives the assignee time to act. Independent matrix event from the breach itself." },
  { evt: "First non-system non-submitter comment", action: "Response clock closes. `sla_first_response_at` stamped." },
  { evt: "Ticket resolved", action: "Resolve clock closes. Existing `resolved_at` reused — no schema churn." },
  { evt: "Due passes (5-min scheduler tick)", action: "Breached flag flips, breach timestamp stamped, escalation chain fires step-by-step on `delay_minutes`, in-app + immediate email fans out (bypasses digest)." },
];

const dashboardTiles = [
  { label: "Breached now", note: "Named tickets and who has them, most overdue first." },
  { label: "Due soon", note: "At-risk clocks before they blow." },
  { label: "Paused right now", note: "Vendor vs internal, longest first. Only tickets paused right now." },
  { label: "Late this month", note: "Each breached clock and how late it landed." },
];

const webhookKinds = [
  { name: "slack",     dest: "Incoming-webhook URL", msg: "Block Kit message." },
  { name: "teams",     dest: "Teams Workflows URL",  msg: "Adaptive Card." },
  { name: "pagerduty", dest: "Events API v2 routing key", msg: "One incident per ticket + clock. Resolves itself when the ticket does. Severity mapped from priority." },
  { name: "generic",   dest: "Any URL", msg: "JSON, HMAC-SHA256 signed in `X-Resolvd-Signature` when a secret is set." },
];

const holidayRules = [
  { rule: "On a date", ex: "`2026-06-08`, or every year: *Every December 25*." },
  { rule: "Weekday rule", ex: "*4th Thursday of November*, *last Monday of May*." },
  { rule: "Observed", ex: "Saturday holiday taken Friday, Sunday holiday taken Monday." },
  { rule: "Multi-day", ex: "Thanksgiving Thursday + Friday as one rule, up to 14 days." },
  { rule: "Early close", ex: "Christmas Eve open until noon, closed after." },
];

const escalationTriggers = [
  { name: "warning_response",  note: "80% of response clock — pre-breach nudge." },
  { name: "warning_resolve",   note: "80% of resolve clock — pre-breach nudge." },
  { name: "breach_response",   note: "Response clock blew. Loud fanout + step chain." },
  { name: "breach_resolve",    note: "Resolve clock blew. Loud fanout + step chain." },
];

const assignmentStrategies = [
  { name: "round_robin",   note: "Cycle through the pool in order. Cursor advances atomically via `UPDATE…RETURNING` so concurrent inserts don't double-pick." },
  { name: "case_load",     note: "Pick whoever has fewest open tickets right now. Ties break by user_id ASC." },
  { name: "specific_user", note: "Always assign to a fixed user." },
];

const roadmap = [
  { tag: "Next", title: "Per-customer SLA contracts", body: "Override a policy by company (not just project) so MSP customer-tier SLAs map directly to the contract that pays for them. Billing contracts shipped in v0.11.0; SLA targets don't key off them yet." },
  { tag: "Planned", title: "IF/THEN rules engine", body: "Admin-built \"when this matches, do that\" overrides for SLA, assignment and notifications. First use: skip the response clock when the submitter is the assigned agent." },
  { tag: "Planned", title: "SLA compliance trends", body: "Per-agent and per-project compliance over a rolling 90 days. The SLA card is current-state and month-to-date today." },
];
---

<Layout title="SLA Tracker — Resolvd" description="Per-priority + per-project SLA targets, pause-on-blocker, business hours with holiday rules and per-location hours, escalation chains with on-call rotations, and breach webhooks to Slack, Teams, PagerDuty or any URL.">
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-4xl px-6 pt-20 pb-12 md:pt-28">
      <span class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-xs text-[var(--color-fg-muted)]">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-brand)] shadow-[0_0_8px_var(--color-brand)]"></span>
        SLA tracking
      </span>
      <h1 class="mt-2 text-4xl md:text-6xl font-bold tracking-tight leading-[1.05]">
        Two clocks. <span class="text-[var(--color-brand)]">Fair pauses.</span> Loud breaches.
      </h1>
      <p class="mt-6 text-lg text-[var(--color-fg-muted)] leading-relaxed max-w-2xl">
        Response + resolve targets per priority, with per-project overrides. Pre-breach warnings at 80%. Clocks pause on blocker statuses and count only business hours. Holidays and per-location hours stop the clock when you're closed. Escalation chains page whoever is on call, and breach webhooks land in Slack, Teams or PagerDuty. Auto-assignment picks an agent at create time so the clock starts on the right person.
      </p>
      <div class="mt-10 flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-emerald-400/40 bg-emerald-400/10 text-xs font-semibold text-emerald-300 tracking-wider uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-300"></span> On track
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-amber-400/40 bg-amber-400/10 text-xs font-semibold text-amber-300 tracking-wider uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-300"></span> Paused
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-rose-400/40 bg-rose-400/10 text-xs font-semibold text-rose-300 tracking-wider uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-rose-300"></span> Breached
        </span>
      </div>
    </div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[500px] -z-10 opacity-[0.04]" style="background-image: linear-gradient(to right, var(--color-fg-strong) 1px, transparent 1px), linear-gradient(to bottom, var(--color-fg-strong) 1px, transparent 1px); background-size: 32px 32px;"></div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Two clocks</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Response. <span class="text-[var(--color-brand)]">Resolve.</span></h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Every ticket carries a <strong class="text-[var(--color-fg-strong)]">response</strong> clock (closes when someone other than the submitter posts a non-system comment) and a <strong class="text-[var(--color-fg-strong)]">resolve</strong> clock (closes when the ticket reaches a resolved state). Both stamp due-ats at create from the policy resolved for that priority.
          </p>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Org defaults live in <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">sla_policies</code> keyed on priority. Project overrides key on priority + project — a project override always beats the org default.
          </p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Defaults</span>
          <div class="mt-2 overflow-x-auto rounded-xl border border-[var(--color-border)]">
            <table class="w-full text-sm">
              <thead class="bg-[var(--color-surface-2)] text-left text-xs uppercase tracking-wide text-[var(--color-fg-muted)]">
                <tr>
                  <th class="px-4 py-3">Priority</th>
                  <th class="px-4 py-3">Response</th>
                  <th class="px-4 py-3">Resolve</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[var(--color-border)]">
                {targets.map(t => (
                  <tr>
                    <td class="px-4 py-3 font-mono text-[var(--color-brand)]">{t.p}</td>
                    <td class="px-4 py-3 text-[var(--color-fg-muted)]">{t.response}</td>
                    <td class="px-4 py-3 text-[var(--color-fg-muted)]">{t.resolve}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-xs text-[var(--color-fg-dim)]">Tune in <strong class="text-[var(--color-fg-strong)]">Admin → SLA policies</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="max-w-2xl">
        <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Lifecycle</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Pause when the <span class="text-[var(--color-brand)]">blame shifts</span>.</h2>
        <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
          A status carrying the <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">awaiting_input</code> or <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">on_hold</code> semantic tag pauses both clocks — vendor / customer wait time stops counting against you. Resume on transition out shifts due-ats forward by the paused duration.
        </p>
      </div>
      <div class="mt-10 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] divide-y divide-[var(--color-border)]">
        {lifecycle.map(l => (
          <div class="px-5 py-4 flex flex-col md:flex-row md:items-start gap-1.5 md:gap-4">
            <span class="font-mono text-xs text-[var(--color-brand)] md:mt-0.5 md:shrink-0 md:min-w-[14ch]">{l.evt}</span>
            <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed md:flex-1" set:html={l.action.replace(/`([^`]+)`/g, '<code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">$1</code>')}></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Breach fanout</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Loud. <span class="text-[var(--color-brand)]">Bypasses digests.</span></h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            A 5-minute scheduler flips the breached flag, stamps the breach timestamp, and fans out via <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">fanoutSlaBreach</code> — in-app notification + immediate email to assignee, followers, and submitter (deduped). Breaches are action-required, so the email always sends instantly regardless of digest cadence.
          </p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Dashboard SLA card</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Tickets, <span class="text-[var(--color-brand)]">not tallies</span>.</h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            The SLA card names tickets instead of counting them, so you can act from the dashboard. Breached and at-risk lists skip closed and resolved tickets; project totals stay as chips. Submitters don't see the card.
          </p>
          <div class="mt-5 grid grid-cols-2 gap-2">
            {dashboardTiles.map(t => (
              <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-3">
                <div class="text-xs font-medium text-[var(--color-fg-strong)]">{t.label}</div>
                <p class="mt-0.5 text-[11px] text-[var(--color-fg-muted)] leading-snug">{t.note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>


  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="max-w-2xl">
        <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Breach webhooks</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Breaches land <span class="text-[var(--color-brand)]">where your team already is</span>.</h2>
        <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
          <strong class="text-[var(--color-fg-strong)]">Admin → SLA policies → Breach notifications</strong> posts response and resolve breaches, plus at-risk warnings if you want them, alongside the in-app and email fanout. Filter each hook by project and priority (<em>P1 only</em> up to <em>All</em>). Every hook has a delivery log and a <strong class="text-[var(--color-fg-strong)]">Send test</strong> button.
        </p>
      </div>
      <div class="mt-10 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] divide-y divide-[var(--color-border)]">
        {webhookKinds.map(w => (
          <div class="px-5 py-4 flex flex-col md:flex-row md:items-start gap-1.5 md:gap-4">
            <code class="font-mono text-xs text-[var(--color-brand)] md:mt-0.5 md:shrink-0 md:min-w-[11ch]">{w.name}</code>
            <span class="text-xs text-[var(--color-fg-dim)] md:mt-0.5 md:shrink-0 md:min-w-[22ch]">{w.dest}</span>
            <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed md:flex-1" set:html={w.msg.replace(/`([^`]+)`/g, '<code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">$1</code>')}></p>
          </div>
        ))}
      </div>
      <p class="mt-5 text-xs text-[var(--color-fg-dim)]">URLs, routing keys and signing secrets are stored encrypted and never sent back to the browser.</p>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Business hours</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Clocks count <span class="text-[var(--color-brand)]">working hours only</span>.</h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">business_hours_policies</code> carries a timezone, day mask, and start/end times — per-project or org default. Plugs into the SLA clock via <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">addBusinessMinutes()</code>.
          </p>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Friday 4pm + 4hr response target now lands Monday 12pm, not Saturday 8pm. Seeded Mon–Fri 9–5 Central; add per-project overrides for customer-specific hours.</p>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            <strong class="text-[var(--color-fg-strong)]">Per-location hours.</strong> A location can have its own window, which replaces the policy's hours for tickets at that site. Tickets pick up the submitter's location on create, and escalation delays follow the same window.
          </p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Pre-breach warnings</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Soft nudge at <span class="text-[var(--color-brand)]">80%</span>.</h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Every policy gets a <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">warning_threshold_percent</code> (default 80) that fires <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">fanoutSlaWarning</code> before the actual breach.
          </p>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Independent matrix event from the breach itself — users can opt out of warnings without losing breach pages, or vice versa.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Holidays</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Closed means <span class="text-[var(--color-brand)]">the clock stops</span>.</h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Each business-hours policy carries its own holiday list. The SLA clock and escalation delays skip a holiday like a weekend, and billing prices holiday work at the weekend rate. All three read the same rules.
          </p>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            No national set is seeded, so you enter your own. Each policy's holidays are also a calendar anyone can subscribe to from <strong class="text-[var(--color-fg-strong)]">Account settings → Calendar</strong>.
          </p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Rule types</span>
          <div class="mt-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] divide-y divide-[var(--color-border)]">
            {holidayRules.map(h => (
              <div class="px-5 py-3 flex flex-col md:flex-row md:items-start gap-1 md:gap-3">
                <span class="text-sm font-medium text-[var(--color-fg-strong)] md:shrink-0 md:min-w-[12ch]">{h.rule}</span>
                <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed md:flex-1" set:html={h.ex.replace(/`([^`]+)`/g, '<code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">$1</code>').replace(/\*([^*]+)\*/g, '<em>$1</em>')}></p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <img src="/blog/v0-11-0/sla-holidays.png" alt="Business hours with holiday rules: Thanksgiving spanning two days, Christmas Eve closing at noon" loading="lazy" class="mt-10 w-full rounded-xl border border-[var(--color-border)]" />
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="max-w-2xl">
        <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Escalation chains</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Step-by-step <span class="text-[var(--color-brand)]">on four triggers</span>.</h2>
        <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
          Per-policy step lists fire on four triggers. Each step has a <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">delay_minutes</code> grace period, walked through business hours when the policy has them, and one or more actions: notify a user, role, the assignee or whoever is on call; reassign to a user, role, the next agent or the on-call person; or bump priority. Project-scoped steps run additively alongside org defaults — a per-project nudge can coexist with an org-wide "page the on-call" step. Each step fires once per ticket.
        </p>
      </div>
      <div class="mt-8 grid md:grid-cols-2 lg:grid-cols-4 gap-3">
        {escalationTriggers.map(t => (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
            <code class="block font-mono text-xs text-[var(--color-brand)] mb-1.5">{t.name}</code>
            <p class="text-xs text-[var(--color-fg-muted)] leading-relaxed">{t.note}</p>
          </div>
        ))}
      </div>
      <p class="mt-5 text-xs text-[var(--color-fg-dim)]">Priority operators (<code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">=</code> / <code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">&lt;</code> / <code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">&lt;=</code> / <code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">&gt;</code> / <code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">&gt;=</code>) apply on the match — one step can cover P1 + P2 with <code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">&lt;= 2</code> instead of duplicating rows.</p>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">On-call rotations</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Page <span class="text-[var(--color-brand)]">whoever is on</span>.</h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Members take shifts in turn from a handoff time, so there are no shift rows to maintain. Overrides cover swaps and leave. A project's own rotations beat the org-wide ones.
          </p>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Two escalation actions use them: <strong class="text-[var(--color-fg-strong)]">Notify on-call</strong> reaches the on-call person of every matching rotation, and <strong class="text-[var(--color-fg-strong)]">Reassign to on-call</strong> hands the ticket to the first. A step with nobody on call waits and retries until someone is.
          </p>
          <p class="mt-4 text-xs text-[var(--color-fg-dim)]"><strong class="text-[var(--color-fg-strong)]">Admin → On-call rotations</strong> shows who's on now and the next shifts.</p>
        </div>
        <img src="/blog/v0-11-0/oncall-rotation.png" alt="An on-call rotation with who's on now and the next shifts" loading="lazy" class="w-full rounded-xl border border-[var(--color-border)]" />
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Auto-assignment</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Pick an agent <span class="text-[var(--color-brand)]">at create time</span>.</h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Per-priority assignment policies pick an agent the moment a ticket lands so the clock starts on a named human, not an empty assignee. Eligible agents come from a per-project <strong class="text-[var(--color-fg-strong)]">Agent flag</strong> on <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">project_members</code> — a Tech can be an Agent on Project A but not Project B without a role change.
          </p>
          <p class="mt-4 text-xs text-[var(--color-fg-dim)]">Priority operators apply here too — one row <code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">&lt;= 2 → round_robin</code> covers the high-touch tier.</p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Strategies</span>
          <div class="mt-2 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] divide-y divide-[var(--color-border)]">
            {assignmentStrategies.map(s => (
              <div class="px-5 py-3 flex flex-col md:flex-row md:items-start gap-1 md:gap-3">
                <code class="font-mono text-xs text-[var(--color-brand)] md:mt-0.5 md:shrink-0 md:min-w-[13ch]">{s.name}</code>
                <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed md:flex-1" set:html={s.note.replace(/`([^`]+)`/g, '<code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">$1</code>')}></p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Vendor vs internal</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Are we slow, or is our <span class="text-[var(--color-brand)]">vendor slow?</span></h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            The <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">awaiting_input</code> and <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">on_hold</code> semantic tags split into two counters — <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">sla_vendor_wait_seconds</code> (waiting on external party) and <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">sla_internal_hold_seconds</code> (we blocked ourselves).
          </p>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            The dashboard SLA card renders a stacked bar across both. Answers the question without parsing audit logs.
          </p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Time-in-status</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Per-status durations, <span class="text-[var(--color-brand)]">window-pickable</span>.</h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">/api/sla/time-in-status</code> aggregates per-status durations from the audit log using <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">LEAD</code> window functions. Surfaced on the dashboard with a 7 / 30 / 90 day window picker — find the status that always eats your clock.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="max-w-2xl">
        <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Roadmap</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">What's <span class="text-[var(--color-brand)]">next</span>.</h2>
        <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
          v0.6.0 shipped clocks + pauses + breach fanout + dashboard. v0.7.0 added pre-breach warnings, business hours, escalation chains, auto-assignment, and vendor-vs-internal reporting. v0.11.0 added on-call rotations, breach webhooks, holiday rules and per-location hours. Queue below.
        </p>
      </div>
      <div class="mt-10 grid md:grid-cols-2 gap-4">
        {roadmap.map(r => (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
            <div class="flex items-baseline justify-between gap-3 mb-2">
              <h3 class="font-semibold text-[var(--color-fg-strong)]">{r.title}</h3>
              <span class="px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider rounded bg-[var(--color-brand)]/15 text-[var(--color-brand)] border border-[var(--color-brand)]/30">{r.tag}</span>
            </div>
            <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed">{r.body}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-xs text-[var(--color-fg-dim)]">Tracked in <a href="https://github.com/joshhearne/resolvd/blob/main/ROADMAP.md" target="_blank" rel="noopener" class="text-[var(--color-brand)] hover:underline">ROADMAP.md</a>. Open an issue if you want a specific beat prioritized.</p>
    </div>
  </section>

  <FeatureFooter currentHref="/sla/" heading="Tune your SLA policies." subhead="Admin → SLA policies. Pick org defaults, layer project-specific overrides, watch the dashboard card light up at month-end." />
</Layout>
