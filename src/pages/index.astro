---
import Layout from "../layouts/Layout.astro";
import { getLatestRelease } from "../lib/releases";

const latest = await getLatestRelease();
const pillLabel = latest
  ? `${latest.tag}${latest.prerelease ? " — pre-release" : " — latest release"}`
  : "Pre-release — coming soon";

const features = [
  {
    icon: "🎯",
    title: "Projects & Tickets",
    body: "Scoped projects with custom prefixes (WEB-0042). P1–P5 priorities, semantic status chain with one-click Advance, auto-close grace, move between projects, inline title edit.",
  },
  {
    icon: "🖥️",
    title: "Inventory + Action1",
    body: "Top-level Inventory across every managed machine. Action1 connector pulls endpoints, installed software, security posture (patches, vulns, reboot required). Twelve seeded asset types + admin-defined customs + per-source custom-field mapping.",
    href: "/inventory/",
  },
  {
    icon: "📚",
    title: "Knowledge Base",
    body: "Per-project articles and runbooks in a BlockNote editor with version history, ticket suggestions, and Promote-to-KB. Or plug in Trove KB, our open-source docs platform, side by side or as a replacement: collections, runbooks tracked per ticket, knowledge briefs, signed webhooks.",
    href: "/kb/",
  },
  {
    icon: "🚨",
    title: "Alerts + Rules",
    body: "Deduped state-machined view of every problem from Zabbix, Action1, or a generic webhook. Per-source rules pick which severities auto-promote to tickets (promote / notify-only / ignore). Dashboard widget lists top open.",
    href: "/alerts/",
  },
  {
    icon: "⏱️",
    title: "SLA Tracker",
    body: "Response + resolve clocks per priority. Pre-breach warnings at 80%, business-hours clocks, escalation chains, auto-assignment (round-robin / case-load / specific). Vendor-vs-internal wait split on the dashboard.",
    href: "/sla/",
  },
  {
    icon: "✨",
    title: "BYO-AI Rewrites",
    body: "Bring your own OpenAI / Anthropic / Ollama key. ✨ AI button on every composer — tone, verbosity, ELI5. Per-project glossary primes the model with your lingo. Org-managed key + lock + usage badge for cost transparency.",
    href: "/ai/",
  },
  {
    icon: "✉️",
    title: "Email-to-Ticket",
    body: "Email #PREFIX to create tickets, or scope a mailbox to one project so inbound mail without a prefix auto-creates there. Dedup against recent open tickets, signature + reply-marker stripping, per-account banner-strip presets. M365 Graph, Gmail API, or SMTP.",
    href: "/email/",
  },
  {
    icon: "💬",
    title: "Mentions + Notifications",
    body: "@ autocomplete subscribes mentioned users. 6×3 channel matrix (in-app / email / push) per event with email digest cadence — instant, hourly, 12h, or daily. Browser push via VAPID + service worker.",
  },
  {
    icon: "🤝",
    title: "Vendor CRM",
    body: "Companies + contacts scoped per project. Admin-gated Notify Vendor button. Per-vendor pill colors hashed from company id. Auto-mute noisy vendor replies into a daily digest at the configured local time.",
    href: "/vendors/",
  },
  {
    icon: "⚡",
    title: "Bulk Edit & Merge",
    body: "Admin Bulk Edit toggle adds checkboxes — change status / assignee / project across up to 500 tickets in one shot. Bulk reply posts the same comment to many tickets at once. Search-driven Merge picker collapses dupes by ref, title, or description.",
  },
  {
    icon: "🔐",
    title: "Flexible Auth + Hardening",
    body: "Microsoft Entra, Google OAuth, or local with Argon2id. TOTP MFA per role. Login hardened with per-IP rate limit, persistent block on credential stuffing, honeypot + sub-800ms dwell rejection, session regeneration, CSP + HSTS.",
  },
  {
    icon: "🔒",
    title: "Encryption at Rest",
    body: "AES-256-GCM envelope encryption with per-row data keys. HMAC blind index keeps title search working under encryption. Off / Standard / Vault modes.",
  },
];
---

<Layout>
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 pt-24 pb-20 md:pt-32 md:pb-28">
      <div class="flex flex-col items-center text-center">
        <a href="/changelog/" class="group mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] hover:border-[var(--color-border-strong)] transition">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-brand)] shadow-[0_0_8px_var(--color-brand)]"></span>
          {pillLabel}
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05] max-w-4xl">
          Issue tracking that <span class="text-[var(--color-brand)]">stays yours</span>.
        </h1>
        <p class="mt-6 max-w-2xl text-lg md:text-xl text-[var(--color-fg-muted)] leading-relaxed">
          Source-available ticket and project tracker — none of the Jira bloat, all of the workflow you actually need.
          Self-host on a $5 VPS. Your server, your data, no SaaS in the loop.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-3">
          <a href="/install/" class="inline-flex items-center justify-center gap-2 rounded-lg bg-[var(--color-brand)] px-5 py-3 text-sm font-semibold text-[#062814] shadow-[0_0_30px_rgba(34,197,94,0.35)] hover:bg-[var(--color-brand-bright)] transition">
            Self-host free
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="https://github.com/joshhearne/resolvd" target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-5 py-3 text-sm font-semibold text-[var(--color-fg-strong)] hover:bg-[var(--color-surface-2)] transition">
            View source on GitHub
          </a>
        </div>
        <div class="mt-12 w-full max-w-2xl">
          <pre class="code-block text-left" is:raw><span class="c"># 60-second install</span>
<span class="k">git</span> clone https://github.com/joshhearne/resolvd.git
<span class="k">cd</span> resolvd
<span class="k">cp</span> .env.example .env  <span class="c"># edit secrets</span>
<span class="k">docker</span> compose up -d --build</pre>
        </div>
      </div>
    </div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[600px] -z-10 opacity-[0.04]" style="background-image: linear-gradient(to right, var(--color-fg-strong) 1px, transparent 1px), linear-gradient(to bottom, var(--color-fg-strong) 1px, transparent 1px); background-size: 32px 32px;"></div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Everything you'd expect. Nothing you wouldn't.</h2>
        <p class="mt-4 text-[var(--color-fg-muted)]">Built for engineering, support, and ops teams who've outgrown a spreadsheet but don't want to onboard a sales rep.</p>
      </div>
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {features.map(f => {
          const Tag = f.href ? "a" : "div";
          const linkProps = f.href
            ? f.external
              ? { href: f.href, target: "_blank", rel: "noopener" }
              : { href: f.href }
            : {};
          return (
            <Tag
              {...linkProps}
              class={`group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 hover:border-[var(--color-border-strong)] hover:bg-[var(--color-surface-2)] transition ${f.href ? "block" : ""}`}
            >
              <div class="flex items-start justify-between mb-3">
                <div class="text-2xl">{f.icon}</div>
                {f.href && (
                  <span class="text-[var(--color-fg-dim)] group-hover:text-[var(--color-brand)] transition opacity-0 group-hover:opacity-100">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">{f.external ? <><path d="M7 17L17 7"/><path d="M8 7h9v9"/></> : <path d="M5 12h14M13 5l7 7-7 7"/>}</svg>
                  </span>
                )}
              </div>
              <h3 class="font-semibold text-[var(--color-fg-strong)] mb-1.5">{f.title}</h3>
              <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed">{f.body}</p>
              {f.href && (
                <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-[var(--color-brand)] opacity-80 group-hover:opacity-100 transition">
                  {f.external ? "Visit" : "Learn more"}
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform">{f.external ? <><path d="M7 17L17 7"/><path d="M8 7h9v9"/></> : <path d="M5 12h14M13 5l7 7-7 7"/>}</svg>
                </span>
              )}
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Boring stack. <span class="text-[var(--color-brand)]">On purpose.</span></h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">No bespoke runtimes, no exotic databases, no proprietary protocols. Components you already know how to operate, monitor, and back up.</p>
          <ul class="mt-6 space-y-3 text-sm">
            <li class="flex gap-3"><span class="text-[var(--color-brand)] font-mono">→</span><span><strong class="text-[var(--color-fg-strong)]">Postgres 16</strong> for everything: tickets, sessions, branding config. <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">pg_dump</code> is your full backup.</span></li>
            <li class="flex gap-3"><span class="text-[var(--color-brand)] font-mono">→</span><span><strong class="text-[var(--color-fg-strong)]">Node + Express</strong> backend. Argon2 hashing, express-session, Multer uploads.</span></li>
            <li class="flex gap-3"><span class="text-[var(--color-brand)] font-mono">→</span><span><strong class="text-[var(--color-fg-strong)]">React + Vite + Tailwind</strong> frontend, served by nginx in a 30 MB Alpine image.</span></li>
            <li class="flex gap-3"><span class="text-[var(--color-brand)] font-mono">→</span><span><strong class="text-[var(--color-fg-strong)]">Bring your own TLS</strong> — Caddy, nginx, Cloudflare Tunnel, whatever you already run.</span></li>
          </ul>
        </div>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-1">
          <div class="rounded-lg bg-[#050810] p-5 font-mono text-xs leading-relaxed">
            <div class="text-[var(--color-fg-dim)]">┌─ docker-compose.yml ──────────────┐</div>
            <div class="text-[#cbd5e1] mt-2">
              <span class="text-violet-300">services:</span><br />
              &nbsp;&nbsp;<span class="text-violet-300">postgres:</span> <span class="text-emerald-300">postgres:16-alpine</span><br />
              &nbsp;&nbsp;<span class="text-violet-300">backend:</span>&nbsp;&nbsp;<span class="text-emerald-300">node 22 + express</span><br />
              &nbsp;&nbsp;<span class="text-violet-300">frontend:</span> <span class="text-emerald-300">nginx alpine</span><br />
              &nbsp;&nbsp;<span class="text-violet-300">nginx:</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-emerald-300">internal router</span><br />
            </div>
            <div class="text-[var(--color-fg-dim)] mt-3">└────────────────────────────────────┘</div>
            <div class="mt-4 text-[var(--color-fg-muted)]">
              <span class="text-[var(--color-brand)]">▸</span> binds 127.0.0.1:8090<br />
              <span class="text-[var(--color-brand)]">▸</span> volumes: pg-data, uploads<br />
              <span class="text-[var(--color-brand)]">▸</span> total RAM: ~400 MB idle
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-24">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight">Run it yourself.</h2>
        <p class="mt-4 text-[var(--color-fg-muted)] text-lg">Self-host only. No SaaS tier, no per-seat billing, no one else holding your data.</p>
      </div>
      <div class="mt-12 grid md:grid-cols-2 gap-4">
        <a href="/install/" class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-7 text-left hover:border-[var(--color-brand)] transition">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)]">Self-host</span>
            <span class="text-sm font-semibold text-[var(--color-brand)]">Free forever</span>
          </div>
          <h3 class="text-2xl font-bold tracking-tight">Run it on your own hardware.</h3>
          <p class="mt-3 text-sm text-[var(--color-fg-muted)] leading-relaxed">Your data, your VPS, your homelab. Docker compose up and you're running. Source-available under FSL-1.1 — free to self-host, fork, and audit.</p>
          <ul class="mt-5 space-y-2 text-sm text-[var(--color-fg-muted)]">
            <li class="flex gap-2"><span class="text-[var(--color-brand)]">✓</span> Full source on GitHub</li>
            <li class="flex gap-2"><span class="text-[var(--color-brand)]">✓</span> Install wizard or manual setup</li>
            <li class="flex gap-2"><span class="text-[var(--color-brand)]">✓</span> Community support</li>
          </ul>
          <div class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-brand)] group-hover:gap-3 transition-all">
            Install guide
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </div>
        </a>
        <a href="https://github.com/joshhearne/resolvd" target="_blank" rel="noopener" class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-7 text-left hover:border-[var(--color-brand)] transition">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)]">Source</span>
            <span class="text-sm font-semibold text-[var(--color-brand)]">FSL-1.1 → Apache 2.0</span>
          </div>
          <h3 class="text-2xl font-bold tracking-tight">Read it. Fork it. Audit it.</h3>
          <p class="mt-3 text-sm text-[var(--color-fg-muted)] leading-relaxed">Every release is on GitHub. Source-available under FSL-1.1 today, Apache 2.0 two years after each release. Internal commercial use allowed.</p>
          <ul class="mt-5 space-y-2 text-sm text-[var(--color-fg-muted)]">
            <li class="flex gap-2"><span class="text-[var(--color-brand)]">✓</span> Tagged releases + changelog</li>
            <li class="flex gap-2"><span class="text-[var(--color-brand)]">✓</span> Issues and discussions open</li>
            <li class="flex gap-2"><span class="text-[var(--color-brand)]">✓</span> Export your data anytime</li>
          </ul>
          <div class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-brand)] group-hover:gap-3 transition-all">
            Open on GitHub
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </div>
        </a>
      </div>
    </div>
  </section>
</Layout>
